# Site configuration

# Canonical origin. This must match the deployed domain exactly — it is used for
# canonical URLs, Open Graph images, the sitemap, robots.txt and all JSON-LD.
# Currently hardcoded in src/resources/once-ui.config.ts as `baseURL`.
NEXT_PUBLIC_SITE_URL=https://nomanejz.vercel.app

# Google Search Console verification (paste the full meta content value)
GOOGLE_SITE_VERIFICATION=

# Google Search Console / Bing Webmaster / etc. are otherwise set directly in
# src/app/layout.tsx under `metadata.verification`.
